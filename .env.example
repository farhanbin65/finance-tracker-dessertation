# ===== Copy this file to .env and fill in real values =====
# .env is git-ignored. Never commit secrets.

# MongoDB credentials (local dev only — change for any deployment)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_local_only

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_64_char_hex_string